/*
 * Debye dispersive material, pre-voltage update (Engine_Ext_DebyeMaterial).
 *
 * Sparse dispatch: one thread per Debye cell, before the Yee voltage update,
 * where the cell voltage is still V^n:
 *
 *   for every pole k:  W_k' = relax_k * W_k + drive_k * V^n
 *                      pre += W_k' - W_k
 *                      W_k  = W_k'
 *
 * debye_apply_voltage.comp finishes the step after the Yee update.
 * `precise` keeps the CPU's operations: no fused multiply-add.
 */
#version 450

layout(local_size_x = 256) in;

layout(set=0, binding=0) buffer VoltBuf   { float volt[];    };
layout(set=0, binding=1) buffer PoleBuf   { float W[];       };  // [poles][3][count]
layout(set=0, binding=2) buffer PreBuf    { float pre_ADE[]; };  // [3][count]
layout(set=0, binding=3) buffer PosIdxBuf { uint  posIdx[];  };  // [3][count]: x,y,z indices
layout(set=0, binding=4) buffer RelaxBuf  { float relax[];   };  // [poles][3][count]
layout(set=0, binding=5) buffer DriveBuf  { float drive[];   };  // [poles][3][count]
layout(set=0, binding=6) buffer SolveBuf  { float solve[];   };  // [3][count], used by the apply pass

layout(push_constant) uniform PC {
    uint count;       // number of Debye cells
    uint Nx, Ny, Nz;  // global grid dimensions
    uint poles;       // number of Debye poles (DispPC's hasLorADE slot)
    // Temporal blocking: this dispatch owns entries [entryBase, entryEnd) of
    // the list, which the host sorted by x.  The flat sweep passes (0, ~0).
    uint entryBase, entryEnd;
};

void main()
{
    uint gid = gl_GlobalInvocationID.x + entryBase;
    if (gid >= count || gid >= entryEnd) return;

    uint N   = Nx * Ny * Nz;
    uint sYZ = Ny * Nz;
    uint g_base = posIdx[gid] * sYZ + posIdx[count + gid] * Nz + posIdx[2*count + gid];

    for (uint n = 0; n < 3; n++)
    {
        float V = volt[n * N + g_base];
        precise float pre = 0.0;
        for (uint o = 0; o < poles; o++)
        {
            uint k = (o * 3 + n) * count + gid;
            float w_old = W[k];
            precise float w = relax[k] * w_old + drive[k] * V;
            pre += w - w_old;
            W[k] = w;
        }
        pre_ADE[n * count + gid] = pre;
    }
}
